# .env.example
# Claude (Anthropic) API Configuration (Primary)
CLAUDE_MODEL="claude-sonnet-5-5"
CLAUDE_FALLBACK_MODEL="claude-haiku-5-5"
ANTHROPIC_API_KEY="your_claude_api_key_here"
ANTHROPIC_API_KEYS="key1,key2,key3" # Optional: comma separated keys for parallel processing

# Legacy Gemini API Configuration (Fallback)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
VITE_GEMINI_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="your_api_key_here"
GEMINI_API_KEYS="key1,key2,key3" # Optional: comma separated keys for parallel processing

# Firebase Configuration (login system + cloud history)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Supabase — server-side admin/usage tables (service-role key, NOT the anon key)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Supabase — client-side (browser-visible, anon key)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Admin panel — comma-separated Google emails allowed to access /admin
ADMIN_EMAILS="admin1@gmail.com,admin2@gmail.com"

# Auth mode — set to "true" once all clients send Firebase ID tokens.
# In soft mode (default), unauthenticated requests are allowed as "anonymous".
AUTH_REQUIRED=false

# Shared figure storage: server only. Use an owner OAuth refresh token with write access to the target folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Writable question-bank spreadsheet (Questions tab); enable Google Sheets API.
GOOGLE_QUESTIONS_SPREADSHEET_ID=

# Paste full Google share links. These take precedence over the ID settings above.
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_QUESTIONS_SPREADSHEET_URL=

# Register this exact callback URL in your Google OAuth web client.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3002/api/admin/drive/callback
