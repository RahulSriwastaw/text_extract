rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email']) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // History items (PDF conversions)
    match /users/{userId}/history/{historyId} {
      allow list, get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(historyId) &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Mocktest history items
    match /users/{userId}/mocktests/{testId} {
      allow list, get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(testId) &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }
  }
}
